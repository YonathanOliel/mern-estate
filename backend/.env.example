# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=True
SECRET_KEY=your-secret-key-here-change-in-production

# OpenAI Configuration
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_MAX_TOKENS=4096

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost/legalgpt
REDIS_URL=redis://localhost:6379/0

# Legal Templates
TEMPLATES_PATH=../templates
DOCUMENTS_OUTPUT_PATH=./generated_documents

# Hebrew NLP Configuration
HEBREW_MODEL_PATH=./models/hebrew
ENABLE_HEBREW_PROCESSING=True

# Security
JWT_SECRET_KEY=your-jwt-secret-key-here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Email Configuration (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# File Storage
MAX_FILE_SIZE_MB=10
ALLOWED_FILE_EXTENSIONS=pdf,docx,txt

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/legalgpt.log